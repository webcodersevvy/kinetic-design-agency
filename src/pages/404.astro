---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — KINETIC®" description="Off the grid." path="/404/" noindex>
  <section class="page-hero">
    <div class="wrap" style="text-align:center;padding:60px 20px">
      <div class="kicker" style="justify-content:center">404 — Off the grid</div>
      <h1 class="sec-title">Wrong <em>turn.</em></h1>
      <p style="color:var(--muted);margin:14px auto;max-width:40ch">That page wandered off the trail. Let’s get you back somewhere with a pulse.</p>
      <a class="btn btn-gold magnetic" href="/" data-hover style="margin-top:18px">Back home →</a>
    </div>
  </section>
</BaseLayout>
