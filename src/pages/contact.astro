---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — KINETIC® NYC" description="Start something with Kinetic NYC. We answer fast on weekdays." path="/contact/">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Contact — Greene Street, NYC</div>
      <h1 class="sec-title">Say <em>hello.</em></h1>
      <p style="color:var(--muted);max-width:60ch;margin-top:12px">Tell us where this needs to go — the note form is just below, in the footer of every page.</p>
      <a class="btn btn-gold magnetic" href="#contact" data-hover style="margin-top:22px">Jump to the form ↓</a>
    </div>
  </section>
</BaseLayout>
