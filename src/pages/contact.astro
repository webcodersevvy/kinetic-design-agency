---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — KINETIC® NYC" description="Start a project with Kinetic NYC. Avg reply: 6 hours on weekdays." path="/contact/">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Contact — SoHo, NYC</div>
      <h1 class="sec-title">Let’s make<br /><em>it move</em></h1>
      <p style="color:var(--muted);max-width:60ch;margin-top:12px">Tell us where your brand needs to go — the brief form is just below, in the footer of every page.</p>
      <a class="btn btn-lime magnetic" href="#contact" data-hover style="margin-top:22px">Jump to the form ↓</a>
    </div>
  </section>
</BaseLayout>
