---
import BaseLayout from '../layouts/BaseLayout.astro';
import AwardsSection from '../components/AwardsSection.astro';
---
<BaseLayout title="Shelf & Citations — KINETIC® NYC" description="Festival premieres, jury shortlists and community honors — nice things said in public." path="/awards/">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Shelf & citations</div>
      <h1 class="sec-title">Nice things, <em>in public</em></h1>
    </div>
  </section>
  <section class="block tone-graphite" data-tone="dark" aria-label="Awards">
    <div class="wrap">
      <AwardsSection />
    </div>
  </section>
</BaseLayout>
