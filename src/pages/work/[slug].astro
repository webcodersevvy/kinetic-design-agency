---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const work: CollectionEntry<'work'>[] = await getCollection('work');
  return work.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '').split('/').pop() as string },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = { entry: CollectionEntry<'work'> };
const { entry } = Astro.props as Props;
const all: CollectionEntry<'work'>[] = await getCollection('work');
const next = all.find((w) => w.id !== entry.id);
const { Content } = await render(entry);
const slugOf = (e: CollectionEntry<'work'>) => e.id.replace(/\.mdx?$/, '').split('/').pop();
---
<BaseLayout
  title={`${entry.data.title} — KINETIC®`}
  description={entry.data.excerpt}
  path={`/work/${slugOf(entry)}/`}
  image={entry.data.cover}
>
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">{entry.data.client} — {entry.data.year}</div>
      <h1 class="sec-title">{entry.data.title}</h1>
      <p style="color:var(--muted);max-width:60ch;margin-top:12px">{entry.data.excerpt}</p>
      <div style="margin-top:22px;border-radius:18px;overflow:hidden">
        <img src={entry.data.cover} alt={entry.data.coverAlt} style="width:100%;max-height:60vh;object-fit:cover" fetchpriority="high" />
      </div>
      <div class="mani-meta">
        {entry.data.categories.map((c) => <span class="chip" style="border-color:var(--line);color:var(--cream)">{c}</span>)}
        <span class="chip solid">✦ {entry.data.tagDark}</span>
      </div>
      <article style="max-width:68ch;margin-top:22px;color:#cfcbc2">
        <Content />
      </article>
      {next && (
        <a class="btn btn-ghost magnetic" href={`/work/${slugOf(next)}/`} data-hover style="margin-top:28px">
          Next case — {next.data.title} →
        </a>
      )}
    </div>
  </section>
</BaseLayout>
