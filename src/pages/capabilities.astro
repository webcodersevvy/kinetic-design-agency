---
import BaseLayout from '../layouts/BaseLayout.astro';
import Capabilities from '../components/Capabilities.astro';
---
<BaseLayout title="Capabilities — KINETIC® NYC" description="Naming, identity, film and interactive under one Greene Street roof." path="/capabilities/">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Capabilities — Four crafts, one roof</div>
      <h1 class="sec-title">What we do <em>all week.</em></h1>
      <p style="color:var(--muted);max-width:60ch;margin-top:12px">Naming, identity, film and interactive — practiced daily by the same nineteen people since 2019.</p>
    </div>
  </section>
  <section class="block tone-ink" data-tone="dark" aria-label="Capabilities">
    <div class="wrap">
      <Capabilities />
    </div>
  </section>
</BaseLayout>
