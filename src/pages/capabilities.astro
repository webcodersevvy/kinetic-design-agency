---
import BaseLayout from '../layouts/BaseLayout.astro';
import Capabilities from '../components/Capabilities.astro';
---
<BaseLayout title="Capabilities — KINETIC® NYC" description="Brand identity, motion, web and 3D under one SoHo roof." path="/capabilities/">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Capabilities — What we do best</div>
      <h1 class="sec-title">One team.<br /><em>Every frame.</em></h1>
      <p style="color:var(--muted);max-width:60ch;margin-top:12px">Strategy, design, motion, code and sound — senior-only, motion-first, shipping since 2018.</p>
    </div>
  </section>
  <section class="block tone-ink" data-tone="dark" aria-label="Capabilities">
    <div class="wrap">
      <Capabilities />
    </div>
  </section>
</BaseLayout>
