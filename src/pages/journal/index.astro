---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts: CollectionEntry<'journal'>[] = (await getCollection('journal')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<BaseLayout title="Field Notes — KINETIC® NYC" description="Process notes, craft essays and studio culture from Greene Street." path="/journal/">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">07 · Field notes — Thinking out loud</div>
      <h1 class="sec-title">Notes from <em>the studio</em></h1>
      <div class="page-grid" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
        {posts.map((p) => (
          <a class="j-card" href={`/journal/${p.id.replace(/\.mdx?$/, '').split('/').pop()}/`} data-hover>
            <img src={p.data.cover} alt={p.data.coverAlt} loading="lazy" decoding="async" />
            <div><small>{p.data.category} / {p.data.minutes}</small><h4>{p.data.title}</h4><p>{p.data.excerpt}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
