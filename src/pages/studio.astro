---
import BaseLayout from '../layouts/BaseLayout.astro';
import Capabilities from '../components/Capabilities.astro';
import ProcessSection from '../components/ProcessSection.astro';
---
<BaseLayout title="Studio — KINETIC® NYC" description="One team, every frame: brand, motion, web and 3D under one SoHo roof." path="/studio/">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Studio — SoHo, NYC</div>
      <h1 class="sec-title">One team.<br /><em>Every frame.</em></h1>
      <p style="color:var(--muted);max-width:60ch;margin-top:12px">24 designers, animators, directors and creative developers. Senior-only, motion-first, shipping since 2018.</p>
    </div>
  </section>
  <section class="block tone-ink" data-tone="dark" aria-label="Capabilities">
    <div class="wrap">
      <Capabilities />
    </div>
  </section>
  <section class="block tone-paper" data-tone="light" aria-label="Process">
    <div class="wrap">
      <ProcessSection />
    </div>
  </section>
</BaseLayout>
