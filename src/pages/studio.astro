---
import BaseLayout from '../layouts/BaseLayout.astro';
import Capabilities from '../components/Capabilities.astro';
import ProcessSection from '../components/ProcessSection.astro';
---
<BaseLayout title="Studio — KINETIC® NYC" description="A nineteen-person studio on Greene Street: naming, identity, film and interactive since 2019." path="/studio/">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Studio — Greene Street, NYC</div>
      <h1 class="sec-title">A daylight studio <em>with opinions.</em></h1>
      <p style="color:var(--muted);max-width:60ch;margin-top:12px">Nineteen designers, filmmakers and developers. One shared wall, strong coffee, stronger reviews — independent since 2019.</p>
    </div>
  </section>
  <section class="block tone-ink" data-tone="dark" aria-label="Capabilities">
    <div class="wrap">
      <Capabilities />
    </div>
  </section>
  <section class="block tone-paper" data-tone="light" aria-label="Process">
    <div class="wrap">
      <ProcessSection />
    </div>
  </section>
</BaseLayout>
