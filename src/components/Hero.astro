---
import HeroScene from '../islands/HeroScene';
---
<section class="hero" id="hero" data-tone="dark" aria-label="Kinetic intro">
  <HeroScene client:idle />
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-top">
      <div class="loc"><i>● NYC</i><span>Independent practice — Greene Street, New York</span></div>
      <div>EST <span data-clock-hero id="heroClock">00:00:00 EST</span> — 40.71°N, 74.00°W</div>
      <div>Folio — Vol. IV, ’26</div>
    </div>
    <h1 class="hero-title">
      <span class="row"><span>Sharp work for</span></span>
      <span class="row"><span>brands with <em>a pulse.</em></span></span>
    </h1>
    <div class="hero-bottom">
      <div>
        <p class="hero-desc">Kinetic is an independent design and motion studio in New York City. We turn companies into characters — <strong>naming, identity, film, interactive and 3D</strong>, all with a heartbeat.</p>
        <div class="hero-cta">
          <a class="btn btn-gold magnetic" href="#contact" data-hover>Start something ↗</a>
          <a class="btn btn-ghost magnetic" href="/work/" data-hover>See the work</a>
        </div>
      </div>
      <div class="hero-side">
        <div class="showreel">
          <button class="play magnetic" id="playBtn" data-hover data-cursor="Play" aria-label="Play showreel">▶</button>
          <small>Play<br />the reel ’26<br /><u>2 min 14 sec</u></small>
        </div>
        <div class="hero-stats">
          <div><b><span data-count="120">0</span><i>+</i></b><span>Projects shipped</span></div>
          <div><b><span data-count="14">0</span><i>×</i></b><span>Worldwide honors</span></div>
          <div><b><span data-count="96">0</span><i>%</i></b><span>Come back for more</span></div>
        </div>
      </div>
    </div>
  </div>
</section>
