---
import MotionStage from '../islands/MotionStage';
---
<section class="tone-violet" data-tone="dark" id="motion" aria-label="Motion in progress">
  <div class="mstage" id="motion-stage">
    <div class="mstage-bg" aria-hidden="true"></div>
    <div class="mstage-inner">
      <div class="wrap">
        <div class="mstage-kicker reveal">
          <span>Scroll-driven motion — 001</span>
          <span class="pill">● Pinned · Scrubbed · Live</span>
        </div>
      </div>
      <div class="mrow mrow-1">Design <span class="stroke">in motion</span></div>
      <div class="mrow mrow-2"><span class="lime">Every</span> frame counts</div>
      <div class="mrow mrow-3">Made to <span class="stroke">move®</span></div>
      <div class="wrap">
        <div class="mstage-foot">
          <span>Keep scrolling — type rides the scroll</span>
          <span class="mstage-badge" aria-hidden="true">K®<br />26</span>
        </div>
      </div>
    </div>
  </div>
  <MotionStage client:visible />
</section>
