---
import Accordion from '../islands/Accordion';
---
<div class="kicker reveal">03 · What we do best</div>
<div class="cap-grid">
  <div class="cap-left reveal">
    <h2 class="sec-title">One crew. <em>Every frame.</em></h2>
    <p>Naming, design, film, code and sound live in one daylight room on Greene Street — you always talk directly to the person holding the pen.</p>
    <div class="cap-visual">
      <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1000&q=80&auto=format&fit=crop" alt="Kinetic studio crew at work" loading="lazy" decoding="async" />
      <div class="overlay"><span>● Greene St Studio — Live</span><span>19 humans + 2 dogs</span></div>
    </div>
  </div>
  <Accordion client:visible />
</div>

<div class="stats reveal" role="list">
  <div class="stat" role="listitem"><b><span data-count="120">0</span><i>+</i></b><span>Projects shipped worldwide</span></div>
  <div class="stat" role="listitem"><b><span data-count="14">0</span><i>×</i></b><span>Honors from juries & festivals</span></div>
  <div class="stat" role="listitem"><b><span data-count="9">0</span><i>yrs</i></b><span>Independent since 2019</span></div>
  <div class="stat" role="listitem"><b><span data-count="210">0</span><i>M</i></b><span>Organic views on our work</span></div>
</div>
