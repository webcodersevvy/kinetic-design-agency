---
import CtaShader from '../islands/CtaShader';
---
<div class="cta" aria-label="Call to action">
  <div class="cta-box reveal">
    <CtaShader client:visible />
    <span class="orbit o1">✦ Booking Q4 ’26</span>
    <span class="orbit o2">★ NYC → Everywhere</span>
    <h2><span>Give it</span><span class="stroke">a pulse.</span></h2>
    <p>Tell us where this needs to go. You’ll hear back within two working days with first thoughts and an honest number — no twelve-page proposal.</p>
    <div class="cta-actions">
      <a class="btn btn-black magnetic" href="#contact" data-hover>Book a twenty-minute call ↗</a>
      <a class="btn btn-line magnetic" href="mailto:hello-kinetic-agency@outlook.com" data-hover>hello-kinetic-agency@outlook.com</a>
    </div>
  </div>
</div>
