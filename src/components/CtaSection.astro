---
import CtaShader from '../islands/CtaShader';
---
<div class="cta" aria-label="Call to action">
  <div class="cta-box reveal">
    <CtaShader client:visible />
    <span class="orbit o1">✦ AVAILABLE Q3 ’26</span>
    <span class="orbit o2">★ NYC → WORLDWIDE</span>
    <h2><span>Let’s make</span><span class="stroke">it move</span></h2>
    <p>Tell us where your brand needs to go. We’ll reply within 24h with first thoughts, references and a honest budget range — no 12-page proposal fluff.</p>
    <div class="cta-actions">
      <a class="btn btn-black magnetic" href="#contact" data-hover>Book a 20-min call ↗</a>
      <a class="btn btn-line magnetic" href="mailto:hello@kinetic.nyc" data-hover>hello@kinetic.nyc</a>
    </div>
  </div>
</div>
