---
import WorkGrid from '../islands/WorkGrid';
type Card = { slug: string; title: string; tag: string; tagDark: string; excerpt: string; categories: string[]; art: number };
const { items } = Astro.props as { items: Card[] };
---
<div class="work-sec">
  <div class="sec-head reveal">
    <div>
      <div class="kicker">02 · Selected work — 2024 → 2026</div>
      <h2 class="sec-title">Work with <em>a heartbeat</em></h2>
    </div>
    <div>
      <p>Launches, titles, stores and visual engines. Filter by craft — hover to feel it, click to read the story.</p>
    </div>
  </div>
  <WorkGrid client:visible items={items} />
</div>
