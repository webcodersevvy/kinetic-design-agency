---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../islands/Cursor';
import Preloader from '../islands/Preloader';
import SmoothScroll from '../islands/SmoothScroll';
import ScrollEffects from '../islands/ScrollEffects';
import Clocks from '../islands/Clocks';
import HeaderTheme from '../islands/HeaderTheme';
import Ambient from '../islands/Ambient';
import MobileMenu from '../islands/MobileMenu';
import ShowreelModal from '../islands/ShowreelModal';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

type Props = { title?: string; description?: string; path?: string; image?: string; articleDate?: string; noindex?: boolean };
const { title, description, path = '/', image, articleDate, noindex = false } = Astro.props as Props;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spacegrotesk-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrainsmono-var.woff2" as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} path={path} image={image} articleDate={articleDate} noindex={noindex} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="noise" aria-hidden="true"></div>
    <Cursor client:load />
    <Preloader client:load />
    <Header home={isHome} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <div class="modal" id="reelModal" role="dialog" aria-modal="true" aria-label="Showreel">
      <div class="modal-bg" id="modalBg"></div>
      <div class="modal-box">
        <button class="modal-close" id="modalClose">CLOSE ✕</button>
        <iframe id="reelFrame" src="" allow="autoplay; fullscreen" allowfullscreen title="Kinetic showreel 2026"></iframe>
      </div>
    </div>

    <SmoothScroll client:load />
    <ScrollEffects client:load />
    <Clocks client:idle />
    <HeaderTheme client:idle />
    <Ambient client:load />
    <MobileMenu client:load />
    <ShowreelModal client:load />
  </body>
</html>
